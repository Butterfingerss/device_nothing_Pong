# Camera buffer allocation and GPU/DMA-heap access for 50 MP frames
allow hal_camera_default {
    qcom_dma_heap_device
    ion_device
    vendor_dmabuf_system_heap_device
    vendor_dmabuf_user_contig_heap_device
    vendor_dmabuf_display_heap_device
    gpu_device
}:chr_file rw_file_perms;

allow hal_camera_default {
    sysfs_kgsl
    vendor_sysfs_kgsl
}:dir r_dir_perms;

allow hal_camera_default {
    sysfs_kgsl
    vendor_sysfs_kgsl
}:file rw_file_perms;
